            "\n",
            "struct Line {",
            "\tll slope, intercept;",
            "\tLine(ll s, ll i) : slope(s), intercept(i) {}",
            "\tll value(ll x) {",
            "\t\treturn slope * x + intercept;",
            "\t}",
            "};",
            "class ConvexHullTrick {",
            "private:",
            "\tvector<Line> hull;",
            "\tdouble getIntersection(const Line& l1, const Line& l2) {",
            "\t\treturn (double)(l2.intercept - l1.intercept) / (l1.slope - l2.slope);",
            "\t}",
            "public:",
            "\tConvexHullTrick() {}",
            "\tvoid addLine(ll slope, ll intercept) {",
            "\t\tLine newLine(slope, intercept);",
            "\t\twhile (hull.size() >= 2) {",
            " \t\t\tdouble alpha = getIntersection(hull[hull.size()-2], hull[hull.size()-1]);",
            "\t\t\tdouble beta = getIntersection(hull[hull.size()-1], newLine);",
            "\t\t\tif (alpha < beta) break;",
            "\t\t\thull.pop_back();",
            "\t\t}",
            "\t\thull.push_back(newLine);",
            "\t}",
            "\tll getMinValue(ll x) {",
            "\t\tif (hull.empty()) return LLONG_MAX;",
            "\t\tint low = 0, high = hull.size() - 1;",
            "\t\twhile (high-low>1) {",
            "\t\t\tint mid = (low + high) / 2;",
            "\t\t\tif (hull[mid].value(x) > hull[mid + 1].value(x))",
            "\t\t\t\tlow = mid + 1;",
            "\t\t\telse",
            "\t\t\t\thigh = mid;",
            "\t\t}",
            "\t\tif(hull[low].value(x)<=hull[high].value(x))return hull[low].value(x);",
            "\t\telse return hull[high].value(x);",
            "\t}",
            "};",
