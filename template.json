            "////////////////////////////////////////////////////// Hashing///////////////////////////////////////////////////////////////////////////////////////////////////////////////////\n",
            "void hashes(string s,vi  &pref,vi&a,vi&suffix){",
            "\ta[0]=1;",
            "\tpref[0]=s[0];",
            "\tll n=s.length();",
            "\tsuffix[n-1]=s[n-1];",
            "\tfor(int i=1;i<n;i++){",
            "\t\tpref[i]=(pref[i-1]*A+s[i]) %B;",
            "\t\tsuffix[n-i-1]=(suffix[n-i]*A+s[n-i-1])%B;",
            "\t\ta[i]=(a[i-1]*A)%B;",
            "\t}",
            "}",
            "ll hash_val(ll i ,ll j,vi &pref, vi&a){",
            "\tif(i==0) return pref[j];",
            "\telse return ((pref[j]-pref[i-1]*a[j-i+1])%B+B)%B;",
            "}",
            "ll hash_val2(ll i,ll j,vi &suffix,vi &a,ll n){",
            "\tif(j==n-1) return suffix[i];",
            "\telse return ((suffix[i]-suffix[j+1]*a[j-i+1])%B+B)%B;",
            "}",
