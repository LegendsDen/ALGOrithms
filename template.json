            "\tfact[0] = invFact[0] = 1;",
            "\tfor (int i = 1; i < MAX; i++) {",
            "\t\tfact[i] = fact[i - 1] * i % mod;",
            "\t}",
            "\tinvFact[MAX - 1] = modPow(fact[MAX - 1], mod - 2); // Fermat's inverse",
            "\tfor (int i = MAX - 2; i >= 1; i--) {",
            "\t\tinvFact[i] = invFact[i + 1] * (i + 1) % mod;",
            "\t}",
            "}",
            "// Compute C(n, r) % mod",
            "long long nCr(int n, int r) {",
            "\tif (r < 0 || r > n) return 0;",
            "\t return fact[n] * invFact[r] % mod * invFact[n - r] % mod;",
            "}",
