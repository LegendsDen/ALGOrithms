            "//////////////////////////////////////////////////////SEGMENT TREE///////////////////////////////////////////////////////////////////////////////////////////////////////////////////\n",
            " class SegmentTree{",
            "public:",
            "vector<ll>trees;",
            "vector<ll>lazy;",
            "\n",
            "ll seg(ll node,ll low,ll high,ll s,ll e){",
            "\tif(s<=low&&high<=e) {",
            "\t\treturn trees[node];",
            "\t}",
            "\tif(high<s||e<low){",
            "\t\treturn 0;",
            "\t}",
            "\tll mid=(low+high)/2;",
            "\treturn seg(2*node,low,mid,s,e)+",
            "\t\tseg(2*node+1,mid+1,high,s,e);",
            "}",
            "\n",
            "//update recursive;",
            "void update(ll node,ll low,ll high,ll s,ll e,ll v){",
            "\tif(s<=low&&high<=e) {",
            "\t\t //i m a leaf",
            "\t\ttrees[node]=v;",
            "\t\treturn ;",
            "\t}",
            "\tif(high<s||e<low){",
            "\t\treturn ;",
            "\t}",
            "\tll mid=(low+high)/2;",
            "\tupdate(2*node,low,mid,s,e,v);// go to left child",
            "\tupdate(2*node+1,mid+1,high,s,e,v);// go to right child",
            "\ttrees[node]=trees[2*node]+trees[2*node+1]; //now those values known,so changes at parent node",
            "}",
            "\n",
            "void rangeUpdates(ll node,ll low,ll high,ll s ,ll e,ll val){",
            "\tif(lazy[node]!=0){",
            "\t\ttrees[node]+=(high-low+1)*lazy[node];",
            "\t\tif(low!=high){",
            "\t\t\tlazy[2*node]+=lazy[node];",
            "\t\t\tlazy[2*node+1]+=lazy[node];",
            "\t\t}",
            "\t\tlazy[node]=0;",
            "\t}",
            "\tif(e<low||s>high||low>high) return;",
            "\tif(low>=s&&high<=e){",
            "\t\ttrees[node]+=(high-low+1)*val;",
            "\t\tif(low!=high){",
            "\t\t\tlazy[2*node]+=val;", // only those node goes which are covered inside completely
            "\t\t\tlazy[2*node+1]+=val;",
            "\t\t}",
            "\t\treturn;",
            "\t}",
            "\tll mid=(high+low)>>1;",
            "\trangeUpdates(2*node,low,mid,s,e,val);",
            "\trangeUpdates(2*node+1,mid+1,high,s,e,val);",
            "\ttrees[node]=trees[2*node]+trees[2*node+1];",
            "}",
            "\n",
            "ll lazySum(ll node,ll low,ll high,ll s,ll e){",
            "\tif(lazy[node]!=0){",
            "\t\ttrees[node]+=(high-low+1)*lazy[node];",
            "\t\tif(low!=high){",
            "\t\t\tlazy[2*node]+=lazy[node];",
            "\t\t\tlazy[2*node+1]+=lazy[node];",
            "\t\t}",
            "\t\tlazy[node]=0;",
            "\t}",
            "\tif(e<low||s>high||low>high) return 0;",
            "\tif(low>=s&&high<=e) return trees[node];",
            "\tll mid=(low+high)>>1;",
            "\treturn lazySum(2*node,low,mid,s,e)+",
            "\t\tlazySum(2*node+1,mid+1,high,s,e);",
            "}",
            "};",
